{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "components": ["src/components"],
      "components/*": ["src/components/*"],
      "configs": ["src/configs"],
      "configs/*": ["src/configs/*"],
      "constants": ["src/constants"],
      "constants/*": ["src/constants/*"],
      "contexts": ["src/contexts"],
      "contexts/*": ["src/contexts/*"],
      "data": ["src/data"],
      "data/*": ["src/data/*"],
      "types": ["src/types"],
      "types/*": ["src/types/*"],
      "utils": ["src/utils"],
      "utils/*": ["src/utils/*"]
    }
  }
}
